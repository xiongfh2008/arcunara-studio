# Arcunara Studio — environment variables template
#
# Copy to .env for local (non-Docker) runs, e.g.:
#   node --env-file=.env apps/api/server.mjs
# (.env is gitignored; never commit real values.)
#
# apps/api/server.mjs reads these variables directly. Defaults match the
# validated VPS v0.2.0 deployment (legacy-v02/server.mjs), so an empty
# environment reproduces the Docker default behavior.

# Directory where project data is persisted ({uuid}/index.html + meta.json).
ARCU_DATA_DIR=/app/data

# Path to the bearer token file (read once at startup, trimmed).
# The file must be non-empty; the server refuses to start otherwise.
ARCU_TOKEN_FILE=/run/secrets/api_token

# Listen ports and bind addresses of the two HTTP servers.
ARCU_API_PORT=3000
ARCU_PREVIEW_PORT=3001
ARCU_API_HOST=0.0.0.0
ARCU_PREVIEW_HOST=0.0.0.0

# v0.3.0 upload-engine limits (enforced while streaming). Defaults:
ARCU_MAX_ZIP_BYTES=20971520          # 20 MiB compressed ZIP
ARCU_MAX_EXTRACT_BYTES=83886080      # 80 MiB total uncompressed
ARCU_MAX_FILE_BYTES=20971520         # 20 MiB per extracted file
ARCU_MAX_HTML_BYTES=2097152          # 2 MiB per HTML file (archives/uploads)
ARCU_MAX_FILES=2000
ARCU_MAX_DEPTH=20
ARCU_MAX_PATH_LENGTH=256
ARCU_MAX_DESCRIPTION_CHARS=1000
ARCU_MAX_UPLOAD_BODY_BYTES=25165824  # 24 MiB total multipart body
# Legacy JSON upload cap (kept byte-identical with v0.2.0):
# ARCU_MAX_JSON_BODY_BYTES=262144
